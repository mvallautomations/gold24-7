# GOLD24-7 Research & Paper-Trading Environment Configuration
# HARD SAFETY: LIVE TRADING IS STRICTLY DISABLED.

ENVIRONMENT=PAPER
ALLOW_LIVE_EXECUTION=false
IS_SIMULATION_ONLY=true

# Broker & Symbol Resolver
DEFAULT_BROKER=XM
DEFAULT_SYMBOLS=["XAUUSD", "GAUUSD", "BTCUSD", "ETHUSD"]

# MetaTrader 5 MCP Bridge
MT5_MCP_SERVER_URL=http://172.26.144.1:8080/sse
MT5_HOST=172.26.144.1
MT5_PORT=8080

# Hermes 3:8B on GPU via Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
HERMES_MODEL=hermes3:8b
HERMES_TIMEOUT_SEC=30.0

# OpenTraderWorld Integration
OTW_BASE_URL=http://127.0.0.1:5454
OTW_DATABASE_URL=postgres://otw:ffec9865bcfd7b23553814d390129df4d7440334657d9b4d@172.28.53.3:5432/opentraderworld
OTW_DEFAULT_CATEGORY_ID=e170b267-7875-4afb-9f71-4abbc1f7cd52

# Paper Trading & Risk Parameters
INITIAL_PAPER_BALANCE=10000.0
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=2
SLIPPAGE_POINTS_ESTIMATE=1.5

# Research Dashboard
DASHBOARD_PORT=8585
